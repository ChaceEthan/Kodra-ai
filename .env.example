# ==============================
# KODRA AI AGENT
# ==============================
#
# Copy this file to .env and adjust values for your local setup:
#   cp .env.example .env
# .env is gitignored and must never be committed.
#
# Every value below has a safe local-development default. Kodra AI Agent
# runs entirely on KodraGPT (PyTorch) and requires NONE of the external
# provider keys in this file to start, train, evaluate, or generate code.

NODE_ENV=development

# ------------------------------
# Frontend / Express Gateway
# ------------------------------

APP_HOST=0.0.0.0
APP_PORT=3000
APP_URL=http://localhost:3000

# ------------------------------
# Python FastAPI Backend
# ------------------------------

KODRA_BACKEND_HOST=127.0.0.1
KODRA_BACKEND_PORT=8000
KODRA_BACKEND_URL=http://127.0.0.1:8000

# ------------------------------
# Kodra Core
# ------------------------------

KODRA_CORE_DIR=./kodra-core
# One of: tiny, small, base, medium (see kodra-core/configs/model_sizes.py).
# Only "tiny" ships with a trainable-on-CPU config validated in this repo.
KODRA_MODEL_SIZE=tiny
# One of: auto, cpu, cuda. "auto" picks CUDA/MPS if available, else CPU.
KODRA_DEVICE=auto

KODRA_CHECKPOINT_DIR=./kodra-core/checkpoints
KODRA_DATA_DIR=./kodra-core/data

# ------------------------------
# Kodra Runtime Security
# ------------------------------

# Not currently enforced anywhere in the backend - authentication is not yet
# implemented, so this stays blank. See kodra-core/configs/env.py. Never put
# a real secret in this .example file.
KODRA_API_KEY=

# Comma-separated list of origins allowed to call the gateway/backend APIs.
KODRA_ALLOWED_ORIGINS=http://localhost:3000

# Terminal/shell execution is a roadmap tool and stays disabled by default.
KODRA_ENABLE_TERMINAL_TOOLS=false
# Mutating agent tools (create_file, edit_file, apply_patch, run_tests,
# run_terminal) require explicit human approval by default. Do not disable
# this outside of an isolated/sandboxed environment.
KODRA_REQUIRE_TOOL_APPROVAL=true

# ------------------------------
# Optional External AI Providers
# ------------------------------

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# These providers are OPTIONAL.
# KodraGPT must work without them.
# They may later be used for teacher-model training,
# synthetic datasets, benchmarking, or fallback inference.

# ------------------------------
# Repository Context / Vector Store
# ------------------------------

VECTOR_DB_PROVIDER=local
VECTOR_DB_PATH=./kodra-core/data/vector_store

# ------------------------------
# Logging
# ------------------------------

LOG_LEVEL=INFO
